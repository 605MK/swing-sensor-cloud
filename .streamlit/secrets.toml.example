# ============================================================
# Streamlit Community Cloud の Secrets 設定テンプレート
# ============================================================
# このファイルをコピーして内容を埋め、Streamlit Cloud の
# 「Secrets」欄に貼り付けてください（ファイルとしてはアップロード不要）。
# ============================================================

# ── GitHub 連携（必須）────────────────────────────────────────
# Personal Access Token（repo スコープが必要）
GITHUB_TOKEN = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# リポジトリ名（"ユーザー名/リポジトリ名" の形式）
GITHUB_REPO = "your-username/swing-sensor"

# ── LINE 通知（任意）─────────────────────────────────────────
# LINE Notify のトークン（https://notify-bot.line.me/ で取得）
# 不要な場合はこの行ごと削除してください
# NOTIFY_LINE_TOKEN = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── メール通知（任意）────────────────────────────────────────
# 不要な場合はこれらの行ごと削除してください
# NOTIFY_EMAIL_ENABLED = "true"
# NOTIFY_EMAIL_SMTP    = "smtp.gmail.com"
# NOTIFY_EMAIL_PORT    = "587"
# NOTIFY_EMAIL_USER    = "your-email@gmail.com"
# NOTIFY_EMAIL_PASSWORD = "your-app-password"   # Gmail アプリパスワード
# NOTIFY_EMAIL_TO      = "destination@example.com"
